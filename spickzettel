# ANSI-Farbdefinitionen nach optimi-Norm mit unzerstörbarer Fettschrift
BOLD = "\033[1m"
BLUE = "\033[34m"
BOLD_BLUE = "\033[1;34m"
CYAN = "\033[36m"
BOLD_CYAN = "\033[1;36m"
GREEN = "\033[32m"
BOLD_GREEN = "\033[1;32m"
YELLOW = "\033[1;33m"
RED = "\033[1;31m"
RESET = "\033[0m"

# Hintergrund-Hervorhebungen (Badges)
BG_HEADER = "\033[1;97;48;5;24m"   # Royalblau mit strahlendem Weiß
BG_CMD = "\033[1;36;48;5;236m"      # Dezentes Anthrazit mit fettem Cyan

# Farbunterdrückung bei gesetzter NO_COLOR-Umgebungsvariable oder Umleitung
if "NO_COLOR" in os.environ or not sys.stdout.isatty():
    BOLD = ""
    BLUE = ""
    BOLD_BLUE = ""
    CYAN = ""
    BOLD_CYAN = ""
    GREEN = ""
    BOLD_GREEN = ""
    YELLOW = ""
    RED = ""
    BG_HEADER = ""
    BG_CMD = ""
    RESET = ""

ANSI_REGEX = re.compile(r'\033\[[0-9;]*m')

def visible_len(s: str) -> int:
    """Ermittelt die tatsächliche sichtbare Zeichenlänge ohne ANSI-Farbcodes."""
    return len(ANSI_REGEX.sub('', s))

def pad_visible(s: str, target_width: int) -> str:
    """Füllt eine Zeichenkette unter Berücksichtigung unsichtbarer ANSI-Codes auf."""
    vlen = visible_len(s)
    if vlen < target_width:
        return s + (' ' * (target_width - vlen))
    return s

def make_header_badge(title: str) -> str:
    """Formatiert eine Überschrift mit Hintergrund-Hervorhebung."""
    if BG_HEADER:
        return f"{BG_HEADER} {title} {RESET}"
    return f"{BOLD_BLUE}{title}{RESET}"

def make_cmd_badge(cmd: str) -> str:
    """Formatiert einen Befehl mit dezentem Code-Block-Hintergrund."""
    if BG_CMD:
        return f"{BG_CMD} {cmd} {RESET}"
    return f"{BOLD_CYAN}{cmd}{RESET}"

