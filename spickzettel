def get_item_desc(item: tuple, width: int) -> str:
    """Wählt dynamisch die optimale Beschreibungsvariante anhand der verfügbaren Breite."""
    long_desc = item[1]
    short_desc = item[2] if len(item) > 2 else long_desc
    # Wenn die Spaltenbreite unter 85 Spalten liegt, greift die prägnante Kurzform
    if width < 85:
        return short_desc
    return long_desc

def get_terminal_size_robust(default_cols: int = 80, default_lines: int = 24) -> tuple[int, int]:
    """Ermittelt zuverlässig Spalten und Zeilen des echten Terminals, auch in Pipes."""
    try:
        cols = int(os.environ.get("COLUMNS", 0))
        lines = int(os.environ.get("LINES", 0))
        if cols > 0 and lines > 0:
            return cols, lines
        if cols > 0:
            return cols, default_lines
    except Exception:
        pass

    for stream in (sys.stdout, sys.stderr, sys.stdin):
        try:
            if hasattr(stream, "fileno"):
                cols, lines = os.get_terminal_size(stream.fileno())
                if cols > 0 and lines > 0:
                    return cols, lines
        except Exception:
            pass

    try:
        with open("/dev/tty") as tty:
            cols, lines = os.get_terminal_size(tty.fileno())
            if cols > 0 and lines > 0:
                return cols, lines
    except Exception:
        pass

    try:
        sz = shutil.get_terminal_size((default_cols, default_lines))
        return sz.columns, sz.lines
    except Exception:
        return default_cols, default_lines

class SingleLineHelpFormatter(argparse.HelpFormatter):
    """Formatierer nach txt2pdf-Norm für einzeilige Optionsbeschreibungen."""
    def _split_lines(self, text, width):
        return [text]

def filter_entries(search_term: str):
    """Filtert Abschnitte und Einträge basierend auf einem Suchbegriff."""
    normalized_term = search_term.strip().lower()
    filtered = []
    total_matches = 0
    for section_title, items in CATEGORIES:
        matching_items = []
        for item in items:
            cmd = item[0]
            long_desc = item[1]
            short_desc = item[2] if len(item) > 2 else ""
            if (normalized_term in cmd.lower() or
                normalized_term in long_desc.lower() or
                normalized_term in short_desc.lower() or
                normalized_term in section_title.lower()):
                matching_items.append(item)
        if matching_items:
            filtered.append((section_title, matching_items))
            total_matches += len(matching_items)
    return filtered, total_matches

def print_banner(width: int, search_term: str = None, match_count: int = 0, compact_vert: bool = False):
    """Gibt den standardisierten Programmkopf nach optimi-Farbnorm aus."""
    banner_text = "TERMINAL-SPICKZETTEL"
    lead = "" if compact_vert else "\n"
    print(f"{lead}{make_header_badge(banner_text)}")
    if search_term:
        print(f"{BOLD}Suchfilter:{RESET} '{search_term}' {BOLD}({match_count} Treffer){RESET}")
    else:
        total_commands = sum(len(items) for _, items in CATEGORIES)
        print(f"{BOLD}Kategorien:{RESET} {len(CATEGORIES)} Abschnitte | {total_commands} Befehle")
    print(f"{BLUE}{'─' * width}{RESET}")

def print_footer(width: int, compact_vert: bool = False):
    """Gibt die Abschlusszeile nach optimi-Norm aus."""
    lead = "" if compact_vert else "\n"
    print(f"{lead}{BLUE}{'━' * width}{RESET}")
    print(f"{BOLD}Navigation:{RESET} Pfeiltasten für Befehlsverlauf | {BOLD_CYAN}[Tab]{RESET} Autovervollständigung")
    print(f"{BOLD}Optionen:{RESET} {CYAN}sz -h{RESET} (Hilfe) | {CYAN}sz -k{RESET} (Kompakt) | {CYAN}sz -s <begriff>{RESET} (Suchen)\n")

def calc_optimal_cmd_col(items: list[tuple], width: int) -> int:
    """Berechnet die maßgeschneiderte Spaltenbreite für Befehls-Badges im Abschnitt."""
    badge_lens = [visible_len(make_cmd_badge(c[0])) for c in items]
    sorted_lens = sorted(badge_lens)
    max_cmd = sorted_lens[-1]

    # Begrenze die Befehlsspalte dynamisch auf maximal 44 % der Abschnittsbreite
    max_allowed = max(14, int(width * 0.44))
    cmd_col = min(max_cmd, max_allowed)
    desc_avail = width - 4 - cmd_col - 2

    # Wenn der Platz für die Beschreibung knapp ist (< 34 Zeichen) und der längste Befehl ein Ausreißer ist
    if desc_avail < 34 and len(sorted_lens) > 3:
        p75_idx = int(len(sorted_lens) * 0.75)
        p75_len = sorted_lens[p75_idx]
        if max_cmd - p75_len >= 5:
            cmd_col = min(p75_len, max_allowed)

    return cmd_col

def format_section_lines(section_title: str, items: list[tuple], width: int, force_compact: bool, force_table: bool) -> list[str]:
    """Erzeugt formatierte Zeilen eines Abschnitts für ein- oder mehrspaltige Ausgabe."""
    lines = []
    lines.append(make_header_badge(section_title))
    lines.append(f"{BLUE}{'─' * width}{RESET}")

    # Bei erzwungenem Kompaktmodus oder extrem schmalem Fenster (< 54 Spalten): reine Zweizeilenform
    if force_compact or (width < 54 and not force_table):
        for item in items:
            cmd = item[0]
            desc = get_item_desc(item, width)
            badge = make_cmd_badge(cmd)
            lines.append(f"  {BOLD_BLUE}▸{RESET} {badge}")
            for l in textwrap.wrap(desc, width=max(16, width - 4)):
                lines.append(f"    {l}")
        return lines

    # Dynamische Tabellenberechnung mit adaptivem Zeilenfall
    cmd_col = calc_optimal_cmd_col(items, width)
    gap = 2
    desc_width = max(16, width - 4 - cmd_col - gap)

    for item in items:
        cmd = item[0]
        desc = get_item_desc(item, width)
        badge = make_cmd_badge(cmd)
        b_len = visible_len(badge)
        if b_len <= cmd_col:
            padded_badge = pad_visible(badge, cmd_col)
            wrapped = textwrap.wrap(desc, width=desc_width)
            first_line = wrapped[0] if wrapped else ""
            lines.append(f"  {BOLD_BLUE}▸{RESET} {padded_badge}{' ' * gap}{first_line}")
            for extra_line in wrapped[1:]:
                lines.append(f"    {' ' * cmd_col}{' ' * gap}{extra_line}")
        else:
            lines.append(f"  {BOLD_BLUE}▸{RESET} {badge}")
            for extra_line in textwrap.wrap(desc, width=max(16, width - 4)):
                lines.append(f"    {extra_line}")

    return lines

def render_single_column(categories, width: int, force_compact: bool, force_table: bool, compact_vert: bool):
    """Rendert Abschnitte einspaltig mit garantiertem Abstand vor Überschriften."""
    for i, (title, items) in enumerate(categories):
        if i > 0:
            print()
        lines = format_section_lines(title, items, width, force_compact, force_table)
        for line in lines:
            print(line)

def render_two_columns(categories, total_width: int, force_compact: bool, force_table: bool, compact_vert: bool):
    """Rendert Abschnitte zweispaltig mit vertikaler Trennlinie nebeneinander für breite Monitore."""
    sep = f"  {BLUE}│{RESET}  "
    gutter_width = 5
    col_width = max(30, (total_width - gutter_width) // 2)

    for i in range(0, len(categories), 2):
        if i > 0:
            print(f"{' ' * col_width}{sep}")
        left_cat = categories[i]
        right_cat = categories[i + 1] if i + 1 < len(categories) else None

        left_lines = format_section_lines(left_cat[0], left_cat[1], col_width, force_compact, force_table)
        right_lines = format_section_lines(right_cat[0], right_cat[1], col_width, force_compact, force_table) if right_cat else []

        max_rows = max(len(left_lines), len(right_lines))
        for r in range(max_rows):
            left_str = pad_visible(left_lines[r] if r < len(left_lines) else "", col_width)
            right_str = right_lines[r] if r < len(right_lines) else ""
            print(f"{left_str}{sep}{right_str}")

def main():
    parser = argparse.ArgumentParser(
        prog="spickzettel",
        formatter_class=lambda prog: SingleLineHelpFormatter(prog, max_help_position=16, width=220),
        description="Übersichtlicher Spickzettel für Terminal-Navigation und Datei-Interaktion.",
        add_help=False
    )
    parser.add_argument("-h", action="help", help="Hilfe anzeigen")
    parser.add_argument("-k", dest="kompakt", action="store_true", default=False, help="Kompakte zweizeilige Darstellung erzwingen (ideal für schmale Fenster)")
    parser.add_argument("-t", dest="tabelle", action="store_true", default=False, help="Tabellarische zweispaltige Darstellung erzwingen")
    parser.add_argument("-1", dest="single_col", action="store_true", default=False, help="Einspaltige Darstellung auch bei breitem Fenster erzwingen")
    parser.add_argument("-s", dest="suche", metavar="BEGRIFF", default=None, help="Spickzettel nach Befehl oder Beschreibung durchsuchen")

    args = parser.parse_args()

    width, lines = get_terminal_size_robust()
    width = max(40, width)
    compact_vertical = lines < 28

    if args.suche:
        active_categories, match_count = filter_entries(args.suche)
        if not active_categories:
            print(f"\n{YELLOW}⚠ WARNUNG:{RESET} Keine Treffer für Suchbegriff '{args.suche}' gefunden.\n")
            sys.exit(0)
    else:
        active_categories = CATEGORIES
        match_count = sum(len(items) for _, items in CATEGORIES)

    print_banner(width, search_term=args.suche, match_count=match_count, compact_vert=compact_vertical)

    # Automatische Wahl: Zweispaltensatz ab 114 Spalten (sofern nicht anders erzwungen), sonst einspaltig
    use_two_cols = (width >= 114) and (not args.single_col) and (not args.kompakt) and (len(active_categories) > 1)

    if use_two_cols:
        render_two_columns(active_categories, width, args.kompakt, args.tabelle, compact_vertical)
    else:
        render_single_column(active_categories, width, args.kompakt, args.tabelle, compact_vertical)

    print_footer(width, compact_vert=compact_vertical)

if __name__ == "__main__":
    main()
