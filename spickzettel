def pick_fluid_description(item: tuple, avail_width: int) -> str:
    """Wählt mikro-adaptiv pro Zeile die längste Textvariante, die ohne Umbruch in avail_width passt."""
    raw = item[1]
    variants = raw if isinstance(raw, (list, tuple)) else item[1:]
    for v in variants:
        if len(v) <= avail_width:
            return v
    return variants[-1]

def get_terminal_size_robust(default_cols: int = 80, default_lines: int = 24) -> tuple[int, int]:
    """Ermittelt zuverlässig Spalten und Zeilen des echten Terminals, auch in Pipes."""
    try:
        cols = int(os.environ.get("COLUMNS", 0))
        lines = int(os.environ.get("LINES", 0))
        if cols > 0 and lines > 0:
            return cols, lines
        if cols > 0:
            return cols, default_lines
    except Exception:
        pass

    for stream in (sys.stdout, sys.stderr, sys.stdin):
        try:
            if hasattr(stream, "fileno"):
                cols, lines = os.get_terminal_size(stream.fileno())
                if cols > 0 and lines > 0:
                    return cols, lines
        except Exception:
            pass

    size = shutil.get_terminal_size((default_cols, default_lines))
    return size.columns, size.lines

class SingleLineHelpFormatter(argparse.HelpFormatter):
    """Kompakter Formatierer für einzeilige Parameterhilfen nach txt2pdf-Norm."""
    def _split_lines(self, text, width):
        return [text]

def filter_entries(search_term: str):
    """Filtert Einträge anhand eines Suchbegriffs (Groß-/Kleinschreibung egal)."""
    term = search_term.lower()
    filtered = []
    total_matches = 0
    for section_title, items in CATEGORIES:
        matching_items = []
        for item in items:
            cmd = item[0]
            raw = item[1]
            variants = raw if isinstance(raw, (list, tuple)) else item[1:]
            matches_cmd = term in cmd.lower()
            matches_section = term in section_title.lower()
            matches_text = any(term in v.lower() for v in variants)
            if matches_cmd or matches_section or matches_text:
                matching_items.append(item)
        if matching_items:
            filtered.append((section_title, matching_items))
            total_matches += len(matching_items)
    return filtered, total_matches

def print_banner(width: int, search_term: str = None, match_count: int = 0, density: str = "normal"):
    """Gibt den Programmkopf anhand der dreistufigen Höhendichte aus."""
    banner_text = "TERMINAL-SPICKZETTEL"
    badge = make_header_badge(banner_text)

    if search_term:
        sub_text = f"{BOLD}Suchfilter:{RESET} '{search_term}' {BOLD}({match_count} Treffer){RESET}"
    else:
        total_commands = sum(len(items) for _, items in CATEGORIES)
        sub_text = f"{BOLD}Kategorien:{RESET} {len(CATEGORIES)} Abschnitte | {total_commands} Befehle"

    # Stufe 1 (Kompakt bei flachem Fenster): Einzeiliger Kopf
    if density == "compact":
        short_sub = f"{len(CATEGORIES)} Abschnitte · {sum(len(items) for _, items in CATEGORIES)} Befehle" if not search_term else f"'{search_term}' ({match_count} Treffer)"
        print(f"{badge}  {BOLD}{short_sub}{RESET}")
    elif density == "generous":
        print(f"\n{badge}")
        print(sub_text)
    else:
        print(f"{badge}")
        print(sub_text)

    print(f"{BLUE}{'─' * width}{RESET}")

def print_footer(width: int, density: str = "normal"):
    """Gibt die Abschlusszeile anhand der dreistufigen Höhendichte aus."""
    lead = "\n" if density == "generous" else ""
    print(f"{lead}{BLUE}{'━' * width}{RESET}")

    if density == "compact":
        print(f"{BOLD}Optionen:{RESET} {CYAN}sz -h{RESET} (Hilfe) | {CYAN}sz -s <begriff>{RESET} (Suchen)\n")
    else:
        print(f"{BOLD}Optionen:{RESET} {CYAN}sz -h{RESET} (Hilfe) | {CYAN}sz -k{RESET} (Kompakt) | {CYAN}sz -s <begriff>{RESET} (Suchen)\n")

def calc_optimal_cmd_col(items: list[tuple], width: int) -> int:
    """Berechnet die Spaltenbreite für Befehls-Badges so, dass Einzeiligkeit gewahrt bleibt."""
    badge_lens = [visible_len(make_cmd_badge(it[0])) for it in items]
    if not badge_lens:
        return 20

    sorted_lens = sorted(badge_lens)
    max_cmd = sorted_lens[-1]

    # Garantiere mindestens 16 Zeichen für die Beschreibung rechts
    max_allowed = max(14, width - 4 - 2 - 16)
    cmd_col = min(max_cmd, max_allowed)
    return cmd_col

def format_section_lines(section_title: str, items: list[tuple], width: int, force_compact: bool, force_table: bool) -> list[str]:
    """Erzeugt formatierte Zeilen eines Abschnitts mit strikter Einzeiligkeits-Garantie."""
    lines = []
    lines.append(make_header_badge(section_title))

    # Bei erzwungenem Kompaktmodus oder extrem schmalem Fenster (< 48 Spalten): zweizeilige Darstellung
    if force_compact or (width < 48 and not force_table):
        for item in items:
            cmd = item[0]
            badge = make_cmd_badge(cmd)
            avail_line = max(16, width - 4)
            desc = pick_fluid_description(item, avail_line)
            lines.append(f"  {BOLD_BLUE}▸{RESET} {badge}")
            for l in textwrap.wrap(desc, width=avail_line):
                lines.append(f"    {l}")
        return lines

    # Dynamische einzeilige Tabellendarstellung (verhindert konsequent Umbrüche auf 2 Zeilen)
    gap = 2
    cmd_col = calc_optimal_cmd_col(items, width)

    for item in items:
        cmd = item[0]
        badge = make_cmd_badge(cmd)
        b_len = visible_len(badge)

        if b_len <= cmd_col:
            avail = max(10, width - 4 - cmd_col - gap)
            desc = pick_fluid_description(item, avail)
            # Sanfter Längenschnitt auf Zeichenebene zur absoluten Verhinderung von Folgezeilen
            if len(desc) > avail:
                desc = desc[:avail]
            padded_badge = pad_visible(badge, cmd_col)
            lines.append(f"  {BOLD_BLUE}▸{RESET} {padded_badge}{' ' * gap}{desc}")
        else:
            # Längerer Befehl: direkt mit 1 Leerzeichen gefolgt von der Beschreibung in derselben Zeile
            avail = max(8, width - 4 - b_len - 1)
            desc = pick_fluid_description(item, avail)
            if len(desc) > avail:
                desc = desc[:avail]
            lines.append(f"  {BOLD_BLUE}▸{RESET} {badge} {desc}")

    return lines

def render_single_column(categories, width: int, force_compact: bool, force_table: bool, density: str):
    """Rendert Abschnitte einspaltig mit dynamischer vertikaler Dichte."""
    spacing = "\n\n" if density == "generous" else "\n"
    for i, (title, items) in enumerate(categories):
        if i > 0:
            print(spacing, end="")
        lines = format_section_lines(title, items, width, force_compact, force_table)
        for line in lines:
            print(line)

def render_two_columns(categories, total_width: int, force_compact: bool, force_table: bool, density: str):
    """Rendert Abschnitte zweispaltig nebeneinander für breite Monitore."""
    gutter_width = 4
    sep = " " * gutter_width
    col_width = (total_width - gutter_width) // 2

    for i in range(0, len(categories), 2):
        if i > 0:
            print()
            if density == "generous":
                print()
        left_cat = categories[i]
        right_cat = categories[i + 1] if i + 1 < len(categories) else None

        left_lines = format_section_lines(left_cat[0], left_cat[1], col_width, force_compact, force_table)
        right_lines = format_section_lines(right_cat[0], right_cat[1], col_width, force_compact, force_table) if right_cat else []

        max_lines = max(len(left_lines), len(right_lines))
        for line_idx in range(max_lines):
            l_line = left_lines[line_idx] if line_idx < len(left_lines) else ""
            r_line = right_lines[line_idx] if line_idx < len(right_lines) else ""
            padded_left = pad_visible(l_line, col_width)
            if r_line:
                print(f"{padded_left}{sep}{r_line}")
            else:
                print(f"{padded_left}")

def main():
    parser = argparse.ArgumentParser(
        prog="spickzettel",
        formatter_class=lambda prog: SingleLineHelpFormatter(prog, max_help_position=24, width=220),
        description="Übersichtlicher Spickzettel für Terminal-Navigation und Datei-Interaktion.",
        add_help=False
    )
    parser.add_argument("-h", action="help", help="Hilfe anzeigen")
    parser.add_argument("-k", "--kompakt", action="store_true", help="Kompakte zweizeilige Darstellung erzwingen (ideal für schmale Fenster)")
    parser.add_argument("-t", "--tabelle", action="store_true", help="Tabellarische zweispaltige Darstellung erzwingen")
    parser.add_argument("-1", "--single-col", action="store_true", help="Einspaltige Darstellung auch bei breitem Fenster erzwingen")
    parser.add_argument("-s", "--suche", metavar="BEGRIFF", type=str, help="Spickzettel nach Befehl oder Beschreibung durchsuchen")
    args = parser.parse_args()

    width, lines = get_terminal_size_robust()
    width = max(40, width)
    
    # Dreistufige vertikale Höhendichte
    if lines < 24:
        density = "compact"
    elif lines >= 38:
        density = "generous"
    else:
        density = "normal"

    if args.suche:
        active_categories, match_count = filter_entries(args.suche)
        if match_count == 0:
            print(f"\n{YELLOW}⚠ WARNUNG:{RESET} Keine Treffer für Suchbegriff '{args.suche}' gefunden.\n")
            return
    else:
        active_categories = CATEGORIES
        match_count = sum(len(items) for _, items in CATEGORIES)

    print_banner(width, search_term=args.suche, match_count=match_count, density=density)

    # Automatische Wahl: Zweispaltensatz ab 114 Spalten (sofern nicht anders erzwungen), sonst einspaltig
    use_two_cols = (width >= 114) and (not args.single_col) and (not args.kompakt) and (len(active_categories) > 1)

    if use_two_cols:
        render_two_columns(active_categories, width, args.kompakt, args.tabelle, density)
    else:
        render_single_column(active_categories, width, args.kompakt, args.tabelle, density)

    print_footer(width, density=density)

if __name__ == "__main__":
    main()
